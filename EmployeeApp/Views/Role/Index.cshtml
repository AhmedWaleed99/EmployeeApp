@model RoleViewModel

@{
    ViewData["Title"] = "Add Role";
    ViewData["ActivePage"] = "Role";
}

<div class="page-head">
    <h1>Add New Role</h1>
    
</div>

<div class="card-box card-box--form">
    <div asp-validation-summary="All" class="form-alert"></div>

    <form asp-action="Add" asp-controller="Role" novalidate>

        <div class="form-field">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter Role name" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="form-actions">
            <a asp-action="Index" asp-controller="Role" class="form-btn form-btn-ghost">Cancel</a>
            <button type="submit" name="Create" class="form-btn form-btn-primary">Save Role</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}