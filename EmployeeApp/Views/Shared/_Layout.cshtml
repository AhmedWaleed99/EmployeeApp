<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeApp.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var active = ViewData["ActivePage"]?.ToString() ?? "Dashboard";
        string Cls(string page) => active == page ? "app-nav__link is-active" : "app-nav__link";
    }

    <div class="app-shell">

        <!-- ===== Sidebar ===== -->
        <aside class="app-sidebar" id="appSidebar">
            <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                <span>Employee Management System</span>
            </a>

            <nav class="app-nav">
                 
                        <a class="@Cls("Dashboard")" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                        </a>  
                   

                    
                <a class="@Cls("Employees")" asp-area="" asp-controller="Employee" asp-action="Index">
                    <i class="bi bi-people-fill"></i><span>Employees</span>
                </a>
                @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                    {
                       <a class="@Cls("Department")" asp-area="" asp-controller="Department" asp-action="Index">
                            <i class="bi bi-building"></i><span>Department</span>
                       </a>
                       <a class="@Cls("Penalty")" asp-area="" asp-controller="Penalty" asp-action="Index">
                            <i class="bi bi-building"></i><span>Penalty</span>
                       </a>

                        <a class="@Cls("Role")" asp-area="" asp-controller="Role" asp-action="Index">
                            <i class="bi bi-shield-check"></i><span>Roles &amp; Permissions</span>
                        </a>
                             <a class="@Cls("Reports")" asp-area="" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-file-earmark-bar-graph"></i><span>Reports</span>
                        </a>
                        
                    }
              

                
           
                <a class="@Cls("Settings")" asp-area="" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear-fill"></i><span>Settings</span>
                </a>
            </nav>

            <a class="app-nav__link app-logout" asp-controller="Account" asp-action="SignOut">
                <i class="bi bi-box-arrow-left"></i><span>Logout</span>
            </a>
        </aside>

        <div class="app-backdrop" id="appBackdrop"></div>

        <!-- ===== Main ===== -->
        <div class="app-main">
            <header class="app-topbar">
                <button class="app-topbar__toggle" id="sidebarToggle" type="button" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>

                <div class="app-search">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Search..." aria-label="Search" />
                </div>

                <div class="app-topbar__right">
                    <button class="app-icon-btn" type="button" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="app-user">
                        <span class="app-avatar">@User.Identity.Name</span>
                        
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            (function () {
                var body = document.body;
                var toggle = document.getElementById('sidebarToggle');
                var backdrop = document.getElementById('appBackdrop');
                if (toggle) toggle.addEventListener('click', function () { body.classList.toggle('sidebar-open'); });
                if (backdrop) backdrop.addEventListener('click', function () { body.classList.remove('sidebar-open'); });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
