@model List<PenaltyType>

@{
    ViewData["Title"] = "Penalty";
    ViewData["ActivePage"] = "Penalty";
}

<div class="page-head page-head--row">
    <div>
        <h1>Penalty</h1>
        <p>Manage company Penalty</p>
    </div>
    <a asp-action="Add" asp-controller="Penalty" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Penalty Type
    </a>
</div>

<div class="card-box card-box--flush">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-building"></i>
            <h2>No departments yet</h2>
            <p>Add your first department to start organizing employees.</p>
            <a asp-action="Add" asp-controller="Penalty" class="btn btn-primary">Add Penalty Type</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Manager</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var status = Convert.ToString(item.IsActive);
                        var isActive = status == "Active" || status == "True";
                        <tr>
                            <td class="text-muted">@item.ID</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.DefaultAmount</td>
                            <td>
                                <span class="badge-status @(isActive ? "" : "badge-status--off")">
                                    @(status == "True" ? "Active" : status == "False" ? "Inactive" : status)
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-controller="Penalty" asp-route-id="@item.ID"
                                   class="icon-action icon-action--edit" title="Edit" aria-label="Edit @item.Name">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-foot">Showing 1 to @Model.Count of @Model.Count</div>
    }
</div>